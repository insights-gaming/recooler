    "integration": "node integration.mjs",
    "maps": "node maps-check.mjs",
    "aggregator": "node aggregator-check.mjs",
    "check": "pnpm graph && pnpm maps && pnpm aggregator && pnpm urls && pnpm context && pnpm integration",

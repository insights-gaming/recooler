{
  "name": "recooler",
  "version": "0.1.0",
  "description": "File-based routing, JSX pages and htmx actions for Hono on Vite",
  "type": "module",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/ssttevee/recooler",
    "directory": "packages/recooler"
  },
  "exports": {
    "./router": { "types": "./dist/router/index.d.ts", "default": "./dist/router/index.js" },
    "./gen": { "types": "./dist/gen/index.d.ts", "default": "./dist/gen/index.js" },
    "./jsx": { "types": "./dist/jsx/index.d.ts", "default": "./dist/jsx/index.js" },
    "./htmx": { "types": "./dist/htmx/index.d.ts", "default": "./dist/htmx/index.js" },
    "./vite": { "types": "./dist/vite/index.d.ts", "default": "./dist/vite/index.js" },
    "./package.json": "./package.json"
  },
  "bin": { "recooler-routes": "./dist/gen/cli.js" },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "easy-jsx-html-engine": "^0.1.13",
    "hono": "^4.12.0 || ^5.0.0-0",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "easy-jsx-html-engine": { "optional": true },
    "vite": { "optional": true }
  },
  "dependencies": {
    "@typescript-eslint/scope-manager": "^8.72.1",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.156.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^22.1.0",
    "easy-jsx-html-engine": "^0.1.13",
    "hono": "^4.13.14",
    "typescript": "^7.0.2",
    "vite": "~8.3.5",
    "vitest": "^5.0.5"
  }
}

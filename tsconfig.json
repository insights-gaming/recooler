{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "jsxImportSource": "easy-jsx-html-engine",
    "types": ["node"],
    "paths": {
      "@insights-gaming/recooler/jsx": ["./src/jsx/index.ts"],
      "@insights-gaming/recooler/jsx/jsx-runtime": ["./src/jsx/jsx-runtime.ts"],
      "@insights-gaming/recooler/jsx/jsx-dev-runtime": ["./src/jsx/jsx-dev-runtime.ts"]
    }
  },
  "include": ["src", "test"]
}
